{
  "name": "hormachuelos-optimized",
  "private": true,
  "version": "1.3.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "stage:cursor-runtime": "node scripts/stage-cursor-runtime.mjs",
    "test": "npm run check && npm run test:agentic && node --test scripts/cursor-completion.test.mjs scripts/cursor-bridge-lifecycle.test.mjs && cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "test:providers": "node --test website/tests/providers.test.mjs website/tests/secret-box.test.mjs website/tests/releases.test.mjs website/tests/hosted-route.test.mjs",
    "test:payments": "node --test website/tests/payments.test.mjs",
    "test:reply-formatting": "node scripts/check_reply_formatting.mjs",
    "verify": "npm run build && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo clippy --locked --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "tauri": "cargo tauri",
    "desktop:dev": "cargo tauri dev",
    "desktop:build": "cargo tauri build",
    "desktop:debug": "npm run build && cargo tauri build --debug",
    "installer:art": "powershell -ExecutionPolicy Bypass -File scripts/generate-installer-art.ps1",
    "release": "node scripts/publish-release.mjs",
    "test:fps": "node --test scripts/fps-optimized-guard.test.mjs",
    "test:update": "node --test scripts/update-version.test.mjs",
    "test:computer-use": "node --test scripts/preview-computer-use.test.mjs scripts/preview-computer-scroll.test.mjs scripts/preview-computer-scroll-runtime.test.mjs scripts/preview-computer-lifecycle.test.mjs",
    "test:ask-mode": "node --test scripts/ask-mode-reliability.test.mjs",
    "test:agentic": "node --test scripts/agentic-contract.test.mjs"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.1.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "node": "24.14.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.23"
  },
  "overrides": {
    "undici": "^6.27.0"
  }
}
